# ============================================================================
# SOUTHERN SPEAR - Unreal Engine source control exclusions
# Adapted from the official Epic Games UE gitignore template.
# Binary assets that MUST be tracked are handled by .gitattributes / Git LFS.
# ============================================================================

# ---------------------------------------------------------------------------
# Freebuff / local agent workspace metadata
# ---------------------------------------------------------------------------
.freebuff/

# ---------------------------------------------------------------------------
# Unreal Engine: always ignore these
# ---------------------------------------------------------------------------
**/DerivedDataCache/
DerivedDataCache/

# Intermediate build files
**/Intermediate/
Intermediate/

# Binaries (C++ output; .target/.modules files)
**/Binaries/
Binaries/
**/Build/
Build/

# Unreal-generated solution and project files
*.sln
*.suo
*.xcodeproj
*.xcworkspace
*.code-workspace
*.vscode/
.vs/
.idea/

# Visual Studio / Rider / VS Code user state
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.opensdf
*.opendb
*.aps
*.ncb
*.pdb
*.ilk
*.idb
*.tlog
*.lastbuildstate
*.log

# ---------------------------------------------------------------------------
# Engine / plugin generated configuration
# These are regenerated by UBT/UHT and must never be hand-merged.
# ---------------------------------------------------------------------------
**/Intermediate/Build/
**/Intermediate/ProjectFiles/
*.xcconfig

# ---------------------------------------------------------------------------
# Local-only configuration
# ---------------------------------------------------------------------------
Config/**/*Local*.ini
Config/DefaultEditorPerProjectUserSettings.ini
Config/DefaultGameUserSettings.ini
Saved/
**/Saved/
.ue4dependencies
*.uassetmanifest
*.target
*.modules
*.version
*.modules

# Crash / logs / autosaves
**/Crashes/
**/Logs/
**/Autosaves/
**/Collections/
**/Config/**/LinuxEditor/
**/Config/**/MacEditor/

# ---------------------------------------------------------------------------
# Platform / packaging output
# ---------------------------------------------------------------------------
Builds/
**/Builds/
Cooked/
**/Cooked/
Packaged/
**/Packaged/
StagedBuilds/
**/StagedBuilds/
Archive/
**/Archive/
Local.ini
**/Local.ini

# ---------------------------------------------------------------------------
# Automation and test artifacts
# ---------------------------------------------------------------------------
Automation/
**/Automation/Artifacts/
AutomationTemp/
**/AutomationTemp/
TestResults/
**/TestResults/
Report/
**/Report/

# ---------------------------------------------------------------------------
# Server and deployment
# ---------------------------------------------------------------------------
ServerConfig/
**/ServerConfig/
*.pem
*.key
!*.pem.example

# ---------------------------------------------------------------------------
# Blender working files (source .blend IS tracked; these are not)
# ---------------------------------------------------------------------------
*.blend1
*.blend2
*.blend3
*.blend4
*.blend5
*.blend6
*.blend7
*.blend8
*.blend9
*.blend10
*.autosave
*.blend_backup*
__pycache__/
*.pyc
render/
out/
/.blender/

# ---------------------------------------------------------------------------
# Source control / VCS noise
# ---------------------------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/c_cpp_properties.json
.vscode/*.log
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.history/

# ---------------------------------------------------------------------------
# Secrets and credentials - NEVER commit
# ---------------------------------------------------------------------------
*.secret
*.secrets
.env
.env.*
!.env.example
**/Credentials/
**/Secrets/
**/EosSettings.local.json
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/GoogleService-Info.plist
**/GoogleService-Info.json
**/agones.yml
**/GameServers.yaml
p4settings.xml

# ---------------------------------------------------------------------------
# Documentation scratch
# ---------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
Thumbs.db
.DS_Store
desktop.ini

# Third-party source drops: never committed until cleared in Docs/LICENCE_REGISTER.md (see Docs/SOURCED_ASSET_REVIEW.md)
Content/Sourced/

# Generated solution files
*.slnx

# Raw Fab packs (ADR-021): ignored until adapted into Southern Spear folders
Content/AK-47/
Content/Insurgent_2/
Content/Modern_Insurgent_7/
Content/FPS_Weapon_Bundle/
Content/Downloaded/
Content/QuantumCharacter/
Content/__ExternalActors__/
Content/__ExternalObjects__/
Content/M1911/
Content/RuralAustralia/
Content/Collections/
Content/Developers/

# Relocated ADFRC third-party source (L-0021).
# Kept out of version control: these are third-party source files redistributed
# from someone else's distribution, not Southern Spear originals, so they must
# not travel via this repository. Authorised for use in the game (ADR-033,
# L-0021); that is a different question from redistributing the source.
# Tracked exception: Art/ADFRC/LICENSE.md and Art/ADFRC/MANIFEST.md only.
Art/ADFRC/*
!Art/ADFRC/LICENSE.md
!Art/ADFRC/MANIFEST.md
Content/FP_AKS74U_Animation/
Content/Military_Radio/
Content/Nanite_Plants_Sample_Collection/
Content/Realistic_Starter_VFX_Pack_Vol2/
Content/Singapore_Canal/
Content/Scene_QuarrySlate/
Content/World_Flags/
Content/SampleAnimationPack/
Content/Vis/
Content/Namaqualand/

# Installed Fab packs that were on disk but never had a .gitignore line, so
# they showed as untracked and any broad `git add` would have committed
# ~6.2 GB of vendor .uasset. Same rule as the block above (ADR-021): vendor
# meshes are referenced in place, never modified, never committed.
Content/AnimStarterPack/
Content/AutomotiveBridgeScene/
Content/ConcreteFPPack/
Content/DeadBodies_Poses_nikoff/
Content/EuropeanBeech/
Content/Light_Foliage/
Content/Modular_Rural_Cabin/
Content/MOUT_Civilian/
Content/MSPresets/
Content/MWLandscapeAutoMaterial/
Content/RustyCarsFree/
Content/StoneWell/

# Installed 2026-10-01 (Session 093), same rule as the block above (ADR-021):
# HighPoly_Tree_Model 38 MB, PN_GrassLibrary 1.1 GB, WaterPlane 140 MB, Splash
# 1.1 MB of vendor .uasset imported into Content/ and referenced in place.
# Registered in Docs/PACK_MANIFEST.md and Docs/ASSET_REGISTER.md; never committed.
# Exception, already tracked before this rule and staying tracked because a committed
# project material needs it: Content/WaterPlane/Lake/Textures/T_MediumWaves_N.uasset
# feeds M_SS_CreekWater (ASSET_REGISTER ENV-005). .gitignore does not untrack a file.
Content/HighPoly_Tree_Model/
Content/PN_GrassLibrary/
Content/Splash/
Content/WaterPlane/

# Converted ADFRC output (L-0021): derived from the third-party source, so also
# kept out of version control. Docs remain tracked.
Art/ADFRC_MLOD/
Art/ADFRC_BLEND/
Art/ADFRC_Player/*
!Art/ADFRC_Player/README.md
!Art/ADFRC_Player/LICENSE.md

# Lyra mannequin exported as a Blender reference (Epic content, R-14)
Art/Characters/ADF/SKM_Manny_ref.fbx

# Local source material, registered in Docs/ASSET_REGISTER.md 4.9d / ENV-001-002 (Session 035):
# blocked or reference-only weapon sources, a Fab optic export (no republishing), raw CC BY scan sources.
Art/Weapons/A88/New/
Art/Weapons/AKM/
Art/Weapons/C4A1/
Art/Weapons/PKM/
Art/Weapons/_Optics/
Content/SouthernSpear/Vendor/

# VibeUE editor MCP toolset (MIT, third-party dev tool; own git clone, not shipped)
Plugins/VibeUE/

# UE5 AI Assistant editor HTTP toolset (MIT, third-party dev tool; not shipped)
Plugins/UE5AIAssistant/
