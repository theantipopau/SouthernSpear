# ============================================================================
# SOUTHERN SPEAR - Unreal Engine source control exclusions
# Adapted from the official Epic Games UE gitignore template.
# Binary assets that MUST be tracked are handled by .gitattributes / Git LFS.
# ============================================================================

# ---------------------------------------------------------------------------
# Freebuff / local agent workspace metadata
# ---------------------------------------------------------------------------
.freebuff/

# ---------------------------------------------------------------------------
# Unreal Engine: always ignore these
# ---------------------------------------------------------------------------
**/DerivedDataCache/
DerivedDataCache/

# Intermediate build files
**/Intermediate/
Intermediate/

# Binaries (C++ output; .target/.modules files)
**/Binaries/
Binaries/
**/Build/
Build/

# Unreal-generated solution and project files
*.sln
*.suo
*.xcodeproj
*.xcworkspace
*.code-workspace
*.vscode/
.vs/
.idea/

# Visual Studio / Rider / VS Code user state
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.opensdf
*.opendb
*.aps
*.ncb
*.pdb
*.ilk
*.idb
*.tlog
*.lastbuildstate
*.log

# ---------------------------------------------------------------------------
# Engine / plugin generated configuration
# These are regenerated by UBT/UHT and must never be hand-merged.
# ---------------------------------------------------------------------------
**/Intermediate/Build/
**/Intermediate/ProjectFiles/
*.xcconfig

# ---------------------------------------------------------------------------
# Local-only configuration
# ---------------------------------------------------------------------------
Config/**/*Local*.ini
Config/DefaultEditorPerProjectUserSettings.ini
Config/DefaultGameUserSettings.ini
Saved/
**/Saved/
.ue4dependencies
*.uassetmanifest
*.target
*.modules
*.version
*.modules

# Crash / logs / autosaves
**/Crashes/
**/Logs/
**/Autosaves/
**/Collections/
**/Config/**/LinuxEditor/
**/Config/**/MacEditor/

# ---------------------------------------------------------------------------
# Platform / packaging output
# ---------------------------------------------------------------------------
Builds/
**/Builds/
Cooked/
**/Cooked/
Packaged/
**/Packaged/
StagedBuilds/
**/StagedBuilds/
Archive/
**/Archive/
Local.ini
**/Local.ini

# ---------------------------------------------------------------------------
# Automation and test artifacts
# ---------------------------------------------------------------------------
Automation/
**/Automation/Artifacts/
AutomationTemp/
**/AutomationTemp/
TestResults/
**/TestResults/
Report/
**/Report/

# ---------------------------------------------------------------------------
# Server and deployment
# ---------------------------------------------------------------------------
ServerConfig/
**/ServerConfig/
*.pem
*.key
!*.pem.example

# ---------------------------------------------------------------------------
# Blender working files (source .blend IS tracked; these are not)
# ---------------------------------------------------------------------------
*.blend1
*.blend2
*.blend3
*.blend4
*.blend5
*.blend6
*.blend7
*.blend8
*.blend9
*.blend10
*.autosave
*.blend_backup*
__pycache__/
*.pyc
render/
out/
/.blender/

# ---------------------------------------------------------------------------
# Source control / VCS noise
# ---------------------------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/c_cpp_properties.json
.vscode/*.log
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.history/

# ---------------------------------------------------------------------------
# Secrets and credentials - NEVER commit
# ---------------------------------------------------------------------------
*.secret
*.secrets
.env
.env.*
!.env.example
**/Credentials/
**/Secrets/
**/EosSettings.local.json
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/GoogleService-Info.plist
**/GoogleService-Info.json
**/agones.yml
**/GameServers.yaml
p4settings.xml

# ---------------------------------------------------------------------------
# Documentation scratch
# ---------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
Thumbs.db
.DS_Store
desktop.ini

# Third-party source drops: never committed until cleared in Docs/LICENCE_REGISTER.md (see Docs/SOURCED_ASSET_REVIEW.md)
Content/Sourced/
